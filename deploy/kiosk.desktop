[Desktop Entry]
Type=Application
Name=Kiosk
Exec=/bin/bash -c "xrandr --output HDMI-1 --rotate right && sleep 5 && /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --no-first-run --incognito --force-device-scale-factor=3 http://localhost:8080/freeside-sign.html"
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
